AI_PROVIDER=baseui
AI_BASE_URL=https://api.psydo.top/v1
AI_API_KEY=replace-with-production-ai-key
AI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=20000

APP_URL=https://study.xmlga.top
SAAS_SESSION_SECRET=replace-with-a-long-random-session-secret
BILLING_WEBHOOK_SECRET=replace-with-a-long-random-billing-secret
REGISTRATION_INVITE_CODE=replace-with-a-private-registration-code
AUTH_RATE_LIMIT_PER_MINUTE=60

POSTGRES_DB=english_training
POSTGRES_USER=english_training
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password

HOST_APP_PORT=3312

# Real-paper self-practice data mounted by docker-compose.production.yml.
# Host paths must exist on the production server before starting the app.
LOCAL_REAL_PAPER_HOST_ROOT=/opt/english-training-cabin/shared/local-real-papers
LOCAL_REAL_PAPER_ANSWER_HOST_ROOT=/opt/english-training-cabin/shared/local-real-answers
LOCAL_REAL_PAPER_ROOT=/app/data/local-real-papers
LOCAL_REAL_PAPER_ANSWER_ROOT=/app/data/local-real-answers
LOCAL_REAL_PAPER_AUDIO_ROOT=/app/data/local-real-papers
LOCAL_REAL_PAPER_GENERATED_AUDIO_ENABLED=false

# Production smoke should fail if the release falls back to the 3 bundled sample PDFs.
SMOKE_REQUIRE_LOCAL_REAL_PAPERS=true
SMOKE_REQUIRE_LOCAL_REAL_ANSWERS=true
SMOKE_MIN_LOCAL_REAL_PAPERS=50
