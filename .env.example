# AI_PROVIDER: "baseui" or "openai-compatible" uses the /v1/chat/completions API.
# For Gemini fallback, set AI_PROVIDER="gemini" and GEMINI_API_KEY instead.
AI_PROVIDER=baseui
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=YOUR_AI_API_KEY
AI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=20000

# Cloud account/session configuration.
# Production must use a long random secret and a durable data path or database-backed adapter.
SAAS_SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SAAS_DATA_FILE=.data/saas-store.json
DATABASE_URL=
BILLING_WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_BILLING_WEBHOOK_SECRET
REGISTRATION_INVITE_CODE=CHANGE_ME_TO_A_PRIVATE_REGISTRATION_CODE
AUTH_RATE_LIMIT_PER_MINUTE=60

# Optional local PDF root for real-paper self practice.
# The scanner accepts either the base folder or the direct 大学英语四级 folder.
LOCAL_REAL_PAPER_ROOT=D:\桌面文件\英语真题-2026-05-31
# Optional centralized answer-index root. Supports 大学英语四级-纯答案.md.
LOCAL_REAL_PAPER_ANSWER_ROOT=D:\桌面文件\真题纯答案-2026-05-31
# Optional local listening-audio root. Put same-name mp3/wav/m4a files here when available.
LOCAL_REAL_PAPER_AUDIO_ROOT=D:\桌面文件\英语真题-2026-05-31
# Optional cache folder for machine-generated listening practice WAV files.
# Leave blank to use %LOCALAPPDATA%\english-training-cabin\local-real-listening-audio on Windows.
LOCAL_REAL_PAPER_GENERATED_AUDIO_ROOT=

# Production docker-compose PostgreSQL settings.
POSTGRES_DB=english_training
POSTGRES_USER=english_training
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_POSTGRES_PASSWORD

# Optional Gemini fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=MY_APP_URL
